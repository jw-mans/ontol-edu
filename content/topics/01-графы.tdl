-- Тема «Графы»: пример наполнения.
-- Имена записей -- одиночные идентификаторы:
-- принадлежность классу несёт связь «instanceOf», а не имя.

-- ЗАПИСИ-ПОНЯТИЯ
КЛАСС граф
  АТРИБУТЫ
    + код : Строка = "гр_1"
    + уровень : цел = 1
КОНЕЦ КЛАСС

КЛАСС паросочетание
  АТРИБУТЫ
    + код : Строка = "гр_2"
    + уровень : цел = 2
КОНЕЦ КЛАСС

КЛАСС вершинноеПокрытие
  АТРИБУТЫ
    + код : Строка = "гр_3"
    + уровень : цел = 2
КОНЕЦ КЛАСС

ЗАВИСИМОСТЬ граф -> Понятие экземпляр
ЗАВИСИМОСТЬ паросочетание -> Понятие экземпляр
ЗАВИСИМОСТЬ вершинноеПокрытие -> Понятие экземпляр

-- ЗАПИСИ-ОПРЕДЕЛЕНИЯ
КЛАСС опрПаросочетание
  АТРИБУТЫ
    + вид : Строка = "формальное"
КОНЕЦ КЛАСС

ЗАВИСИМОСТЬ опрПаросочетание -> Определение экземпляр

АССОЦИАЦИЯ
  опрПаросочетание 1
  --
  паросочетание 1 : определяет

-- ТЕОРЕМА КЁНИГА И ЕЁ ДОКАЗАТЕЛЬСТВО
КЛАСС теоремаКёнига
  АТРИБУТЫ
    + код : Строка = "гр_10"
    + уровень : цел = 3
КОНЕЦ КЛАСС

ЗАВИСИМОСТЬ теоремаКёнига -> Теорема экземпляр

КЛАСС докКёнига
  АТРИБУТЫ
    + метод : Строка = "построение"
КОНЕЦ КЛАСС

ЗАВИСИМОСТЬ докКёнига -> Доказательство экземпляр

КЛАСС шагКёнига1
  АТРИБУТЫ
    + номер : цел = 1
КОНЕЦ КЛАСС

КЛАСС шагКёнига2
  АТРИБУТЫ
    + номер : цел = 2
КОНЕЦ КЛАСС

ЗАВИСИМОСТЬ шагКёнига1 -> ШагДоказательства экземпляр
ЗАВИСИМОСТЬ шагКёнига2 -> ШагДоказательства экземпляр

-- СВЯЗИ МЕЖДУ ЗАПИСЯМИ
АССОЦИАЦИЯ
  паросочетание 1
  --
  граф 1 : требует

АССОЦИАЦИЯ
  вершинноеПокрытие 1
  --
  граф 1 : требует

АССОЦИАЦИЯ
  теоремаКёнига 1
  --
  паросочетание 1 : требует

АССОЦИАЦИЯ
  теоремаКёнига 1
  --
  вершинноеПокрытие 1 : требует

АССОЦИАЦИЯ
  докКёнига 1
  --
  теоремаКёнига 1 : доказывает

КОМПОЗИЦИЯ
  докКёнига 1
  --
  шагКёнига1 1

КОМПОЗИЦИЯ
  докКёнига 1
  --
  шагКёнига2 1

АССОЦИАЦИЯ
  шагКёнига1 1
  --
  паросочетание 1 : обосновано

АССОЦИАЦИЯ
  шагКёнига2 1
  --
  вершинноеПокрытие 1 : обосновано

АССОЦИАЦИЯ
  шагКёнига1 1
  --
  шагКёнига2 1 : далее
