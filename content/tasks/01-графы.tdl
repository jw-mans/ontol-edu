-- Задачи по теме «Графы».
-- Слот «генератор» хранит ИМЯ функции из discrete.variants, а не код:
-- это единственное место, где смысл осознанно выносится из графа.

КЛАСС задПредпосылки
  АТРИБУТЫ
    + код : Строка = "зад_1"
    + уровень : цел = 2
    + вид : Строка = "множество"
    + генератор : Строка = "предпосылки"
    + формулировка : Строка = "Назовите всё, на что опирается запись"
КОНЕЦ КЛАСС

КЛАСС задПрямые
  АТРИБУТЫ
    + код : Строка = "зад_2"
    + уровень : цел = 1
    + вид : Строка = "множество"
    + генератор : Строка = "прямые_предпосылки"
    + формулировка : Строка = "Назовите непосредственные предпосылки"
КОНЕЦ КЛАСС

КЛАСС задОбоснования
  АТРИБУТЫ
    + код : Строка = "зад_3"
    + уровень : цел = 3
    + вид : Строка = "множество"
    + генератор : Строка = "обоснования_доказательства"
    + формулировка : Строка = "На что опираются шаги доказательства"
КОНЕЦ КЛАСС

КЛАСС задОбъединение
  АТРИБУТЫ
    + код : Строка = "зад_4"
    + уровень : цел = 1
    + вид : Строка = "число"
    + генератор : Строка = "мощность_объединения"
    + формулировка : Строка = "Мощность объединения двух множеств"
КОНЕЦ КЛАСС

ЗАВИСИМОСТЬ задПредпосылки -> Задача экземпляр
ЗАВИСИМОСТЬ задПрямые -> Задача экземпляр
ЗАВИСИМОСТЬ задОбоснования -> Задача экземпляр
ЗАВИСИМОСТЬ задОбъединение -> Задача экземпляр

АССОЦИАЦИЯ
  задПредпосылки 1
  --
  теоремаКёнига 1 : проверяет

АССОЦИАЦИЯ
  задПрямые 1
  --
  паросочетание 1 : проверяет

АССОЦИАЦИЯ
  задОбоснования 1
  --
  теоремаКёнига 1 : проверяет
